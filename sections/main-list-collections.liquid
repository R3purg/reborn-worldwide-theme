{% comment %}
  ACCENT COLORS — Per-collection hover tint + index dot
  ─────────────────────────────────────────────────────
  Each collection card reads: collection.metafields.custom.accent_color

  To set up in Shopify admin:
  1. Settings → Custom data → Collections → Add definition
     - Namespace & key : custom.accent_color
     - Type           : Color
     - Name           : Accent color
  2. Open each collection in the admin and set its accent color value
  3. Cards without a value gracefully fall back to the theme's
     primary button colour (--color-button / orange).
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}
{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign active_sort = request.params.sort_by | default: section.settings.sort

  case active_sort
    when 'products_high', 'products_low'
      assign collections = collections | sort: 'all_products_count'
    when 'date', 'date_reversed'
      assign collections = collections | sort: 'published_at'
  endcase

  if active_sort == 'products_high' or active_sort == 'date_reversed' or active_sort == 'alphabetical_reversed'
    assign collections = collections | reverse
  endif

  assign moduloResult = 28 | modulo: section.settings.columns_desktop
  assign paginate_by = 30
  if moduloResult == 0
    assign paginate_by = 28
  endif
-%}

<section class="rw-collist__hero page-width">
  <nav class="rw-collist__breadcrumb" aria-label="{{ 'accessibility.breadcrumbs' | t }}">
    <ol>
      <li>
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t | upcase }}</a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">COLLECTIONS</li>
    </ol>
  </nav>

  <div class="rw-collist__header">
    <div class="rw-collist__header-left">
      {%- if section.settings.kicker != blank -%}
        <p class="rw-collist__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h1 class="rw-collist__title">COLL<span class="rw-collist__title-accent">E</span>CTIONS</h1>
    </div>
    {%- if section.settings.description != blank -%}
      <p class="rw-collist__description">{{ section.settings.description | escape }}</p>
    {%- endif -%}
  </div>
</section>

<div class="rw-collist__hero-spacer" aria-hidden="true"></div>

{%- if section.settings.show_ticker -%}
  {%- liquid
    assign ticker_items = 'EIGHT COLLECTIONS,FOUR CHAPTERS,NO RESTOCKS,SS26 // VOL.04,FROM EASTERN EUROPE' | split: ','
  -%}
  <div class="rw-collection-ticker" aria-hidden="true">
    <div class="rw-collection-ticker__track">
      {%- for _i in (1..2) -%}
        {%- for item in ticker_items -%}
          <span class="rw-collection-ticker__item">
            <span class="rw-collection-ticker__text">{{ item | strip }}</span>
            <span class="rw-collection-ticker__diamond"></span>
          </span>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- paginate collections by paginate_by -%}
  <div class="rw-collist__sort-bar">
    <div class="rw-collist__sort-bar-inner page-width">
      <span class="rw-collist__sort-count">{{ collections.count }} COLLECTIONS</span>
      <form method="get" class="rw-collist__sort-form">
        <label class="rw-collist__sort-label" for="rw-sort-select">SORT BY</label>
        <select
          id="rw-sort-select"
          name="sort_by"
          class="rw-collist__sort-select"
          onchange="this.form.submit()"
          aria-label="{{ 'products.facets.sort_by_label' | t }}"
        >
          <option
            value="alphabetical"
            {% if active_sort == 'alphabetical' %}
              selected
            {% endif %}
          >
            A–Z
          </option>
          <option
            value="alphabetical_reversed"
            {% if active_sort == 'alphabetical_reversed' %}
              selected
            {% endif %}
          >
            Z–A
          </option>
          <option
            value="date_reversed"
            {% if active_sort == 'date_reversed' %}
              selected
            {% endif %}
          >
            Newest
          </option>
          <option
            value="date"
            {% if active_sort == 'date' %}
              selected
            {% endif %}
          >
            Oldest
          </option>
          <option
            value="products_high"
            {% if active_sort == 'products_high' %}
              selected
            {% endif %}
          >
            Most pieces
          </option>
          <option
            value="products_low"
            {% if active_sort == 'products_low' %}
              selected
            {% endif %}
          >
            Fewest pieces
          </option>
        </select>
      </form>
    </div>
  </div>

  <section class="rw-collist__grid-section page-width" aria-label="{{ 'general.collection_labels.collections' | t }}">
    <ul
      class="rw-collist__grid"
      style="--rw-cols: {{ section.settings.columns_desktop }}; --rw-cols-mob: {{ section.settings.columns_mobile }};"
      role="list"
    >
      {%- for collection in collections -%}
        {%- liquid
          assign accent_color = collection.metafields.custom.accent_color.value | default: ''

          assign loading_attr = 'lazy'
          if forloop.index <= 3
            assign loading_attr = 'eager'
          endif

          if section.settings.image_ratio == 'adapt'
            if collection.featured_image
              assign img_ratio = collection.featured_image.width | append: '/' | append: collection.featured_image.height
            else
              assign img_ratio = '4/3'
            endif
          elsif section.settings.image_ratio == 'portrait'
            assign img_ratio = '3/4'
          else
            assign img_ratio = '1/1'
          endif

          if collection.all_products_count < 10
            assign count_display = collection.all_products_count | prepend: '0'
          else
            assign count_display = collection.all_products_count
          endif

          if forloop.index < 10
            assign index_display = forloop.index | prepend: '0'
          else
            assign index_display = forloop.index
          endif
        -%}

        <li class="rw-collist__card-wrap">
          <a
            href="{{ collection.url }}"
            class="rw-collist__card"
          >
            <div
              class="rw-collist__card-image"
              style="aspect-ratio: {{ img_ratio }};"
            >
              {%- if collection.featured_image -%}
                <img
                  srcset="
                    {%- if collection.featured_image.width >= 400 -%}{{ collection.featured_image | image_url: width: 400 }} 400w,{%- endif -%}
                    {%- if collection.featured_image.width >= 800 -%}{{ collection.featured_image | image_url: width: 800 }} 800w,{%- endif -%}
                    {%- if collection.featured_image.width >= 1200 -%}{{ collection.featured_image | image_url: width: 1200 }} 1200w{%- endif -%}
                  "
                  src="{{ collection.featured_image | image_url: width: 800 }}"
                  sizes="(min-width: 990px) {{ 100 | divided_by: section.settings.columns_desktop }}vw, (min-width: 750px) 50vw, 100vw"
                  alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                  width="{{ collection.featured_image.width }}"
                  height="{{ collection.featured_image.height }}"
                  loading="{{ loading_attr }}"
                >
              {%- else -%}
                <div class="rw-collist__card-placeholder" aria-hidden="true">
                  <span class="visually-hidden">{{ collection.title | escape }}</span>
                </div>
              {%- endif -%}

              <div
                class="rw-collist__card-tint"
                aria-hidden="true"
                {% if accent_color != '' %}
                  style="background: {{ accent_color }};"
                {% endif %}
              ></div>

              <div class="rw-collist__card-index" aria-hidden="true">
                <span
                  class="rw-collist__card-dot"
                  {% if accent_color != '' %}
                    style="background: {{ accent_color }};"
                  {% endif %}
                ></span>
                <span class="rw-collist__card-index-num">{{ index_display }}</span>
              </div>

              <div class="rw-collist__card-count" aria-hidden="true">{{ count_display }} PIECES</div>

              <div class="rw-collist__card-bottom">
                <span class="rw-collist__card-title">{{ collection.title | escape }}</span>
                <span class="rw-collist__card-cta" aria-hidden="true">
                  <span>Shop collection</span>
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14"/>
                    <path d="m13 6 6 6-6 6"/>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if paginate.pages > 1 -%}
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main-list-collections.name",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "// THE FULL CATALOGUE"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every chapter, every regular, every last piece. Eight collections, four stories, one studio. Browse by drop or by what's left."
    },
    {
      "type": "checkbox",
      "id": "show_ticker",
      "label": "Show ticker",
      "default": true
    },
    {
      "type": "select",
      "id": "sort",
      "options": [
        {
          "value": "alphabetical",
          "label": "t:sections.main-list-collections.settings.sort.options__1.label"
        },
        {
          "value": "alphabetical_reversed",
          "label": "t:sections.main-list-collections.settings.sort.options__2.label"
        },
        {
          "value": "date_reversed",
          "label": "t:sections.main-list-collections.settings.sort.options__3.label"
        },
        {
          "value": "date",
          "label": "t:sections.main-list-collections.settings.sort.options__4.label"
        },
        {
          "value": "products_high",
          "label": "t:sections.main-list-collections.settings.sort.options__5.label"
        },
        {
          "value": "products_low",
          "label": "t:sections.main-list-collections.settings.sort.options__6.label"
        }
      ],
      "default": "alphabetical",
      "label": "t:sections.main-list-collections.settings.sort.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__3.label"
        }
      ],
      "default": "square",
      "label": "t:sections.main-list-collections.settings.image_ratio.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.main-list-collections.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-list-collections.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-list-collections.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "2",
      "label": "t:sections.main-list-collections.settings.columns_mobile.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-list-collections.name"
    }
  ]
}
{% endschema %}
