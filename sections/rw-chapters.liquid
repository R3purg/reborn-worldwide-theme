{%- style -%}
  #rw-chapters-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<rw-chapters
  id="rw-chapters-{{ section.id }}"
  class="rw-chapters"
  data-interval="6500"
>
  <div class="page-width rw-chapters__inner">

    <div class="rw-chapters__header">
      <div>
        {%- if section.settings.kicker != blank -%}
          <div class="rw-chapters__kicker">{{ section.settings.kicker | escape }}</div>
        {%- endif -%}
        <h2 class="rw-chapters__heading">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.subheading != blank -%}
        <p class="rw-chapters__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="rw-chapters__tab-strip" role="tablist">
        {%- for block in section.blocks -%}
          <button
            class="rw-chapters__tab{% if forloop.first %} rw-chapters__tab--active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="rw-chapters-panel-{{ section.id }}-{{ forloop.index0 }}"
            id="rw-chapters-tab-{{ section.id }}-{{ forloop.index0 }}"
            data-index="{{ forloop.index0 }}"
            data-accent="{{ block.settings.accent_color }}"
            {{ block.shopify_attributes }}
          >
            <span class="rw-chapters__tab-code">CH.{{ block.settings.chapter_number }} / {{ block.settings.chapter_code }}</span>
            <span class="rw-chapters__tab-title">{{ block.settings.title | upcase | escape }}</span>
          </button>
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        <div
          class="rw-chapters__panel"
          role="tabpanel"
          id="rw-chapters-panel-{{ section.id }}-{{ forloop.index0 }}"
          aria-labelledby="rw-chapters-tab-{{ section.id }}-{{ forloop.index0 }}"
          data-index="{{ forloop.index0 }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          <div class="rw-chapters__panel-image">
            {%- if block.settings.image != blank -%}
              {%- assign ch_img_alt = block.settings.image.alt | default: block.settings.title -%}
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  class: 'rw-chapters__img',
                  alt: ch_img_alt,
                  widths: '600, 900, 1200, 1400'
              }}
            {%- else -%}
              <div class="rw-chapters__img-placeholder">
                {{ 'collection-apparel-1' | placeholder_svg_tag: 'rw-chapters__placeholder-svg' }}
              </div>
            {%- endif -%}
            <div class="rw-chapters__panel-badge">
              <span class="rw-chapters__badge-dot" style="background:{{ block.settings.accent_color }}"></span>
              <span class="rw-chapters__badge-text">CHAPTER {{ block.settings.chapter_number }} // {{ block.settings.chapter_code }}</span>
            </div>
            <div class="rw-chapters__panel-title-overlay">{{ block.settings.title | upcase | escape }}</div>
          </div>

          <div class="rw-chapters__panel-story">
            <div>
              {%- if block.settings.kicker != blank -%}
                <div class="rw-chapters__story-kicker" style="color:{{ block.settings.accent_color }}">
                  {{ block.settings.kicker | escape }}
                </div>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <p class="rw-chapters__story-body">{{ block.settings.body | escape }}</p>
              {%- endif -%}
            </div>
            <div class="rw-chapters__story-footer">
              <div class="rw-chapters__story-meta">
                {%- if block.settings.edition_pieces != blank -%}
                  <span>{{ block.settings.edition_pieces | escape }}</span>
                  <span class="rw-chapters__meta-sep" aria-hidden="true">·</span>
                {%- endif -%}
                {%- if block.settings.edition_size != blank -%}
                  <span>{{ block.settings.edition_size | escape }}</span>
                  <span class="rw-chapters__meta-sep" aria-hidden="true">·</span>
                {%- endif -%}
                {%- if block.settings.ships_label != blank -%}
                  <span>{{ block.settings.ships_label | escape }}</span>
                {%- endif -%}
              </div>
              <div class="rw-chapters__story-ctas">
                {%- if block.settings.cta_label != blank -%}
                  <a href="{{ block.settings.cta_link }}" class="rw-chapters__btn rw-chapters__btn--bone">
                    {{ block.settings.cta_label | escape }}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
                    </svg>
                  </a>
                {%- endif -%}
                {%- if block.settings.story_link != blank -%}
                  <a href="{{ block.settings.story_link }}" class="rw-chapters__btn rw-chapters__btn--ghost">
                    Read story
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}

      <div class="rw-chapters__dots" aria-hidden="true">
        {%- for block in section.blocks -%}
          <span
            class="rw-chapters__dot{% if forloop.first %} rw-chapters__dot--active{% endif %}"
            data-index="{{ forloop.index0 }}"
          ></span>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</rw-chapters>

{% stylesheet %}
  .rw-chapters {
    display: block;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }

  /* Header */
  .rw-chapters__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3.2rem;
    gap: 1.6rem;
    flex-wrap: wrap;
  }

  .rw-chapters__kicker {
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.6;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .rw-chapters__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(4rem, 6vw, 8.4rem);
    line-height: 0.9;
    margin: 0;
    color: rgb(var(--color-background));
  }

  .rw-chapters__subheading {
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    letter-spacing: 0.04em;
    opacity: 0.7;
    max-width: 42rem;
    margin: 0;
    line-height: 1.5;
  }

  /* Tab strip */
  .rw-chapters__tab-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .rw-chapters__tab {
    padding: 1.6rem 1.8rem;
    text-align: left;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.18);
    background: transparent;
    color: rgb(var(--color-background));
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .rw-chapters__tab:last-child {
    border-right: none;
  }

  .rw-chapters__tab--active {
    color: #0e0e0e;
  }

  .rw-chapters__tab-code {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
    font-weight: 500;
  }

  .rw-chapters__tab-title {
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* Panel */
  .rw-chapters__panel {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    margin-top: 2.4rem;
    min-height: 52rem;
  }

  .rw-chapters__panel[hidden] {
    display: none;
  }

  /* Image side */
  .rw-chapters__panel-image {
    position: relative;
    overflow: hidden;
    background:
      repeating-linear-gradient(135deg, rgba(255,255,255,.06) 0 14px, rgba(255,255,255,0) 14px 28px),
      #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-right: none;
  }

  .rw-chapters__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .rw-chapters__img-placeholder {
    width: 100%;
    height: 100%;
    min-height: 52rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rw-chapters__placeholder-svg {
    width: 30%;
    opacity: 0.15;
  }

  .rw-chapters__panel-badge {
    position: absolute;
    top: 2rem;
    left: 2rem;
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }

  .rw-chapters__badge-dot {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.4);
    flex-shrink: 0;
  }

  .rw-chapters__badge-text {
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(var(--color-background));
    font-weight: 500;
  }

  .rw-chapters__panel-title-overlay {
    position: absolute;
    left: 2rem;
    bottom: 2rem;
    font-family: var(--font-heading-family);
    font-size: clamp(5.6rem, 8vw, 12.8rem);
    line-height: 0.85;
    color: rgb(var(--color-background));
    max-width: 90%;
    pointer-events: none;
  }

  /* Story side */
  .rw-chapters__panel-story {
    background: #1a1a1a;
    padding: 4rem 3.6rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .rw-chapters__story-kicker {
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
    margin-bottom: 1.8rem;
  }

  .rw-chapters__story-body {
    font-size: 2.2rem;
    line-height: 1.4;
    margin: 0;
    font-weight: 400;
    color: rgb(var(--color-background));
    text-wrap: pretty;
  }

  .rw-chapters__story-footer {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    margin-top: 3.6rem;
  }

  .rw-chapters__story-meta {
    display: flex;
    gap: 1.2rem;
    align-items: center;
    flex-wrap: wrap;
    color: rgba(255, 255, 255, 0.6);
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .rw-chapters__story-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .rw-chapters__btn {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 1.4rem 2.2rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, opacity 0.2s ease;
    border: 1px solid;
    white-space: nowrap;
  }

  .rw-chapters__btn--bone {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    border-color: rgb(var(--color-background));
  }

  .rw-chapters__btn--bone:hover {
    opacity: 0.85;
  }

  .rw-chapters__btn--ghost {
    background: transparent;
    color: rgb(var(--color-background));
    border-color: rgba(255, 255, 255, 0.5);
  }

  .rw-chapters__btn--ghost:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  /* Progress dots */
  .rw-chapters__dots {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.8rem;
    justify-content: flex-end;
  }

  .rw-chapters__dot {
    display: inline-block;
    height: 3px;
    width: 18px;
    background: rgba(255, 255, 255, 0.25);
    transition: width 0.4s ease, background 0.4s ease;
    flex-shrink: 0;
  }

  .rw-chapters__dot--active {
    width: 40px;
  }

  /* Mobile */
  @media (max-width: 989px) {
    .rw-chapters__tab-strip {
      grid-template-columns: repeat(2, 1fr);
    }

    .rw-chapters__tab:nth-child(2) {
      border-right: none;
    }

    .rw-chapters__tab:nth-child(3) {
      border-right: 1px solid rgba(255, 255, 255, 0.18);
      border-top: 1px solid rgba(255, 255, 255, 0.18);
    }

    .rw-chapters__tab:nth-child(4) {
      border-right: none;
      border-top: 1px solid rgba(255, 255, 255, 0.18);
    }
  }

  @media (max-width: 749px) {
    .rw-chapters__panel {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .rw-chapters__panel-image {
      aspect-ratio: 4 / 3;
      min-height: 0;
      border-right: 1px solid rgba(255, 255, 255, 0.12);
      border-bottom: none;
    }

    .rw-chapters__img-placeholder {
      min-height: 28rem;
    }

    .rw-chapters__panel-title-overlay {
      font-size: clamp(4rem, 10vw, 7.2rem);
    }

    .rw-chapters__panel-story {
      padding: 2.4rem 2rem;
    }

    .rw-chapters__story-body {
      font-size: 1.8rem;
    }

    .rw-chapters__header {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rw-chapters__tab { transition: none; }
    .rw-chapters__dot { transition: none; }
    .rw-chapters__btn { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    if (customElements.get('rw-chapters')) return;

    class RwChapters extends HTMLElement {
      connectedCallback() {
        this._tabs = Array.from(this.querySelectorAll('.rw-chapters__tab'));
        this._panels = Array.from(this.querySelectorAll('.rw-chapters__panel'));
        this._dots = Array.from(this.querySelectorAll('.rw-chapters__dot'));
        this._active = 0;
        this._timer = null;

        this._applyTabStyle(this._tabs[0], true);
        this._applyDotStyle(0);

        this._tabs.forEach(function (tab, i) {
          tab.addEventListener('click', function () {
            this._activate(i);
            this._restartTimer();
          }.bind(this));
        }.bind(this));

        this.addEventListener('mouseenter', this._stopTimer.bind(this));
        this.addEventListener('mouseleave', this._startTimer.bind(this));

        this._startTimer();
      }

      disconnectedCallback() {
        this._stopTimer();
      }

      _activate(index) {
        if (this._active === index) return;
        this._active = index;

        this._tabs.forEach(function (tab, i) {
          tab.setAttribute('aria-selected', i === index ? 'true' : 'false');
          this._applyTabStyle(tab, i === index);
        }.bind(this));

        this._panels.forEach(function (panel, i) {
          if (i === index) {
            panel.removeAttribute('hidden');
          } else {
            panel.setAttribute('hidden', '');
          }
        });

        this._applyDotStyle(index);
      }

      _applyTabStyle(tab, active) {
        tab.style.background = active ? (tab.dataset.accent || 'transparent') : 'transparent';
        tab.style.color = active ? '#0e0e0e' : '';
      }

      _applyDotStyle(activeIndex) {
        var accent = this._tabs[activeIndex] ? (this._tabs[activeIndex].dataset.accent || 'rgba(255,255,255,0.25)') : 'rgba(255,255,255,0.25)';
        this._dots.forEach(function (dot, i) {
          dot.style.width = i === activeIndex ? '40px' : '18px';
          dot.style.background = i === activeIndex ? accent : 'rgba(255,255,255,0.25)';
        });
      }

      _startTimer() {
        this._stopTimer();
        var interval = parseInt(this.dataset.interval || '6500', 10);
        var self = this;
        this._timer = setInterval(function () {
          self._activate((self._active + 1) % self._tabs.length);
        }, interval);
      }

      _stopTimer() {
        if (this._timer) {
          clearInterval(this._timer);
          this._timer = null;
        }
      }

      _restartTimer() {
        this._stopTimer();
        this._startTimer();
      }
    }

    customElements.define('rw-chapters', RwChapters);
  })();
{% endjavascript %}

{% schema %}
{
