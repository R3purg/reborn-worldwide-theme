      "label": "Primary button label",
      "default": "Shop chapter 04"
    },
    {
      "type": "url",
      "id": "button_url_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Read the lookbook"
    },
    {
      "type": "url",
      "id": "button_url_2",
      "label": "Secondary button link"
    },
